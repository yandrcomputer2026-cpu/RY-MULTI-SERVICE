generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model transaction {
  id                Int      @id @default(autoincrement())
  userId            Int
  transactionId     String   @unique(map: "Transaction_transactionId_key")
  service           String
  category          String?
  description       String?  @db.Text
  amount            Decimal  @db.Decimal(12, 2)
  status            String   @default("PENDING")
  referenceId       String?
  provider          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  @@index([createdAt], map: "Transaction_createdAt_idx")
  @@index([service], map: "Transaction_service_idx")
  @@index([status], map: "Transaction_status_idx")
  @@index([userId], map: "Transaction_userId_idx")
  @@map("Transaction")
}

enum UserRole {
  RETAILER
  DISTRIBUTOR
  MASTER_DISTRIBUTOR
  FSE
  ADMIN
}

enum RegistrationSource {
  WEBSITE
  FSE
  ADMIN
}

enum NetworkAssignmentStatus {
  ASSIGNED
  PENDING
}

model user {
  id        Int      @id @default(autoincrement())
  userCode  String?  @unique(map: "User_userCode_key")
  name      String
  email     String   @unique(map: "User_email_key")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mobile    String   @unique(map: "User_mobile_key")
  role      UserRole @default(RETAILER)

  // ==========================================
  // REGISTRATION / AREA
  // ==========================================
  registrationSource RegistrationSource      @default(WEBSITE)
  assignmentStatus   NetworkAssignmentStatus @default(PENDING)
  pincode            String?

  // ==========================================
  // FSE ONBOARDING
  // किस FSE ने user को onboard किया
  // ==========================================
  onboardedById Int?

  onboardedBy    user?  @relation("FSEOnboarding", fields: [onboardedById], references: [id], onDelete: SetNull)
  onboardedUsers user[] @relation("FSEOnboarding")

  // ==========================================
  // RETAILER -> DISTRIBUTOR
  // ==========================================
  distributorId Int?

  distributor user?  @relation("DistributorRetailers", fields: [distributorId], references: [id], onDelete: SetNull)
  retailers   user[] @relation("DistributorRetailers")

  // ==========================================
  // DISTRIBUTOR -> MASTER DISTRIBUTOR
  // ==========================================
  masterDistributorId Int?

  masterDistributor user?  @relation("MasterDistributorNetwork", fields: [masterDistributorId], references: [id], onDelete: SetNull)
  distributors      user[] @relation("MasterDistributorNetwork")

  // ==========================================
  // DISTRIBUTOR AREA / PINCODE
  // ==========================================
  distributorAreas distributorArea[] @relation("DistributorAreas")

  // ==========================================
  // FSE WORKING AREA / PINCODE
  // ==========================================
  fseAreas fseArea[] @relation("FSEAreas")

  // ==========================================
  // WALLET - EXISTING
  // ==========================================
  wallet             wallet?
  walletTransactions walletTransaction[]

  // ==========================================
  // KYC
  // ==========================================
  kyc kyc? @relation("UserKyc")

  @@index([role], map: "User_role_idx")
  @@index([onboardedById], map: "User_onboardedById_idx")
  @@index([distributorId], map: "User_distributorId_idx")
  @@index([masterDistributorId], map: "User_masterDistributorId_idx")
  @@index([pincode], map: "User_pincode_idx")
  @@index([assignmentStatus], map: "User_assignmentStatus_idx")
  @@map("User")
}

model distributorArea {
  id Int @id @default(autoincrement())

  distributorId Int

  pincode  String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distributor user @relation("DistributorAreas", fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([distributorId, pincode], map: "DistributorArea_distributorId_pincode_key")
  @@index([pincode, isActive], map: "DistributorArea_pincode_isActive_idx")
  @@index([distributorId], map: "DistributorArea_distributorId_idx")
  @@map("DistributorArea")
}

model fseArea {
  id Int @id @default(autoincrement())

  fseId Int

  pincode  String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fse user @relation("FSEAreas", fields: [fseId], references: [id], onDelete: Cascade)

  @@unique([fseId, pincode], map: "FSEArea_fseId_pincode_key")
  @@index([pincode, isActive], map: "FSEArea_pincode_isActive_idx")
  @@index([fseId], map: "FSEArea_fseId_idx")
  @@map("FSEArea")
}

enum WalletStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND
  ADJUSTMENT
}

enum WalletTransactionSource {
  ADD_MONEY
  SERVICE_PAYMENT
  REFUND
  BANK_SETTLEMENT
  ADMIN_ADJUSTMENT
}

model wallet {
  id Int @id @default(autoincrement())

  userId Int @unique(map: "Wallet_userId_key")

  availableBalance Decimal @default(0) @db.Decimal(12, 2)
  lockedBalance    Decimal @default(0) @db.Decimal(12, 2)

  status WalletStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         user                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions walletTransaction[]

  @@index([status], map: "Wallet_status_idx")
  @@map("Wallet")
}

model walletTransaction {
  id Int @id @default(autoincrement())

  transactionId String @unique(map: "WalletTransaction_transactionId_key")

  walletId Int
  userId   Int

  type   WalletTransactionType
  source WalletTransactionSource

  amount Decimal @db.Decimal(12, 2)

  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  status String @default("PENDING")

  referenceId String?
  description String? @db.Text

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId], map: "WalletTransaction_walletId_idx")
  @@index([userId], map: "WalletTransaction_userId_idx")
  @@index([type], map: "WalletTransaction_type_idx")
  @@index([source], map: "WalletTransaction_source_idx")
  @@index([status], map: "WalletTransaction_status_idx")
  @@index([createdAt], map: "WalletTransaction_createdAt_idx")
  @@map("WalletTransaction")
}

// =====================================================
// KYC
// =====================================================

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

model kyc {
  id Int @id @default(autoincrement())

  userId Int @unique(map: "Kyc_userId_key")

  // Basic KYC details
  panNumber    String?
  aadhaarLast4 String?

  // Document references / URLs
  panDocumentUrl  String?
  aadhaarFrontUrl String?
  aadhaarBackUrl  String?
  profilePhotoUrl String?

  // Verification
  status KycStatus @default(NOT_SUBMITTED)

  rejectionReason String? @db.Text

  verifiedAt DateTime?
  verifiedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation("UserKyc", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status], map: "Kyc_status_idx")
  @@index([createdAt], map: "Kyc_createdAt_idx")
  @@map("Kyc")
}

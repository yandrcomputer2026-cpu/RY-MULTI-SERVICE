generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model transaction {
  id                Int      @id @default(autoincrement())
  userId            Int
  transactionId     String   @unique(map: "Transaction_transactionId_key")
  service           String
  category          String?
  description       String?  @db.Text
  amount            Decimal  @db.Decimal(12, 2)
  status            String   @default("PENDING")
  referenceId       String?
  provider          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  @@index([createdAt], map: "Transaction_createdAt_idx")
  @@index([service], map: "Transaction_service_idx")
  @@index([status], map: "Transaction_status_idx")
  @@index([userId], map: "Transaction_userId_idx")
  @@map("Transaction")
}

model user {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique(map: "User_email_key")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mobile    String   @unique(map: "User_mobile_key")
  @@map("User")
}
